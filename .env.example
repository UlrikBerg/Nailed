# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Database (Hostinger Cloud / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=nailed
DB_PASSWORD=change-me
DB_NAME=nailed
# Hostinger Cloud requires socket connections (users have @localhost grants only,
# not @127.0.0.1/@::1 TCP grants). Set this to the MySQL socket path on the server.
# Find with: ls /var/lib/mysql/*.sock
# Leave blank for local dev with TCP MySQL.
DB_SOCKET=

# JWT signing (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# CORS — comma-separated list of allowed origins (web + native app schemes)
CORS_ORIGINS=http://localhost:3000,https://nailed.no,nailed-app://

# Google OAuth — see GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Vipps Login — pending approval. See VIPPS_INTEGRATION.md.
# Leave empty to keep Vipps disabled. When enabled:
#   VIPPS_ENV=test or production
#   VIPPS_CLIENT_ID, VIPPS_CLIENT_SECRET, VIPPS_MSN, VIPPS_SUBSCRIPTION_KEY
VIPPS_ENV=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_MSN=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_REDIRECT_URI=http://localhost:3000/api/v1/auth/vipps/callback

# Storage backend (Fase 2 — image uploads)
# 'local' writes to ./uploads (served at /uploads/*); 'r2' uses Cloudflare R2.
STORAGE_BACKEND=local

# Local storage (only used when STORAGE_BACKEND=local)
LOCAL_UPLOAD_DIR=./uploads

# Cloudflare R2 (only used when STORAGE_BACKEND=r2). See docs/R2_SETUP.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Bootstrap admin — comma-separated emails that get role=admin on first login
BOOTSTRAP_ADMIN_EMAILS=
